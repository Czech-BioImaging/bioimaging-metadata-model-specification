@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.

<9466e2d1294fc50257dc3e3417d18370provenance_statementShape> a sh:NodeShape;
    sh:targetClass <http://purl.org/dc/terms/ProvenanceStatement>;
    sh:class <http://purl.org/dc/terms/ProvenanceStatement>;
    sh:nodeKind sh:IRI;
    sh:description "Information about entities, activities, and people involved in producing a piece of data or thing."@en;
    sh:name "Provenance Statement"@en.
<705943da99af220e2dc96d0af81607eclabelShape> a sh:PropertyShape;
    sh:description "Provenance state label."@en;
    sh:name "label"@en;
    sh:path rdfs:label;
    sh:datatype <http://www.w3.org/1999/02/22-rdf-syntax-ns#langString>.
<9466e2d1294fc50257dc3e3417d18370provenance_statementShape> sh:property <705943da99af220e2dc96d0af81607eclabelShape>.
