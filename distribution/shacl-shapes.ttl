    sh:name "end-point del servicio"@es, "end-point del servizio"@it, "přístupový bod služby"@cs, "endpoint URL"@en, "tjenesteendpoint"@da;
    sh:minCount 1;
    sh:path <http://www.w3.org/ns/dcat#endpointURL>;
    sh:nodeKind sh:IRI.
