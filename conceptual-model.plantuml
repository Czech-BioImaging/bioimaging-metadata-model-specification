Agent -- Identifier :  "has identifier​​"
Agent -- "Contact details" :  "má kontaktní bod"
"Data Service" -- "1..*" "Related resource" :  "přístupový bod služby"
Subject -- "0..1" "Subject scheme" :  "in subject scheme"
